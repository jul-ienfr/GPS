# =============================================================================
#  secrets.yaml — À COPIER EN `secrets.yaml` ET À REMPLIR
# =============================================================================
#  ⚠️  Ne jamais committer ce fichier une fois rempli (voir .gitignore).
#      Il contient vos credentials WiFi et OTA.
# =============================================================================

# --- WiFi -------------------------------------------------------------------
wifi_ssid: "Mon_WiFi"
wifi_password: "mon_mot_de_passe_wifi"

# Mot de passe du point d'accès de secours (fallback AP)
fallback_password: "un_autre_mot_de_passe"

# --- ESPHome API / OTA ------------------------------------------------------
# Générer une clé avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
api_encryption_key: "COLLER_ICI_LA_CLE_GENEREE"

# Mot de passe pour les mises à jour Over-The-Air
ota_password: "mon_mot_de_passe_ota"

# --- JK BMS -----------------------------------------------------------------
# Adresse MAC Bluetooth du BMS, à relever avec nRF Connect (ou l'app Jikong).
# La vôtre : C8:47:80:2F:02:81
bms0_mac_address: "C8:47:80:2F:02:81"

# --- Traccar (utilisé par traccar.yaml, côté Home Assistant) ----------------
# Hôte Traccar, sans http:// et sans port.
# Exemples : demo.traccar.org, 192.168.1.20, traccar.mondomaine.fr
traccar_host: "demo.traccar.org"

# Port Traccar (5055 = port OsmAnd par défaut)
traccar_port: 5055

# Identifiant du device dans Traccar. Doit correspondre exactement à
# l'identifiant déclaré côté serveur Traccar.
traccar_device_id: "van"

# Identifiants d'un appareil Traccar (voir README § Traccar)
traccar_username: "votre_email@exemple.fr"
traccar_password: "votre_mot_de_passe_traccar"
